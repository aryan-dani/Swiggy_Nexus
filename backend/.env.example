# Groq API key — agentic LLM + AI Sommelier
GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Telegram / web agent brain: auto (Gemini→Groq) | gemini | groq | ollama
# For local rehearsal without burning Gemini quota:
#   LLM_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
#   OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_PROVIDER=auto
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# Public API base (ngrok / Render) — Telegram webhook + approve links
BASE_URL=http://localhost:8000
INTERNAL_TICK_SECRET=nexus-tick-secret

# MCP — live when token present (default unset); force mock for offline demo/CI
# USE_MOCK_MCP=true          # offline / pytest
# USE_MOCK_MCP=false         # force live
# After: python scripts/swiggy_oauth_login.py  then  python scripts/swiggy_mcp_smoke.py
# Catalog: python scripts/swiggy_mcp_tools_list.py
# Probe reads: python scripts/swiggy_mcp_probe.py
# SWIGGY_OAUTH_TOKEN=          # Bearer JWT (~5 days); or use credentials/swiggy_token.json
# SWIGGY_CLIENT_ID=swiggy-mcp  # from DCR (scripts/swiggy_oauth_login.py)
# SWIGGY_REDIRECT_URI=http://127.0.0.1:8765/callback
# Optional endpoint overrides (defaults are production):
# SWIGGY_FOOD_ENDPOINT=https://mcp.swiggy.com/food
# SWIGGY_IM_ENDPOINT=https://mcp.swiggy.com/im
# SWIGGY_DINEOUT_ENDPOINT=https://mcp.swiggy.com/dineout
# MCP_REPLAY_FIXTURES=1        # offline: replay docs/mcp-fixtures instead of Pune catalog

# HITL
NOTIFICATION_PLATFORM=console
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Set false to mute unsolicited Telegram HITL/QoL pushes (inbound bot replies still work)
# TELEGRAM_OUTBOUND_ENABLED=true
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=

# Weather / home
# OPENWEATHER_API_KEY=
HOME_CITY=Pune
HOME_LAT=18.5204
HOME_LNG=73.8567
DEFAULT_ADDRESS_ID=addr_kp_001

# Google Calendar
# GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/google_credentials.json
# GOOGLE_CALENDAR_TOKEN_PATH=credentials/google_token.json
# Set true only for offline CI — demos need live Calendar (default false)
# GOOGLE_CALENDAR_ALLOW_MOCK=false
GOOGLE_PUBSUB_VERIFICATION_TOKEN=nexus-pubsub-secret-token

# CORS
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://swiggy-nexus.vercel.app
# CORS_ORIGIN_REGEX=https://.*\.(onrender|vercel)\.app
