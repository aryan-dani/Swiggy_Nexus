# Groq API key (free tier available at https://console.groq.com/keys)
# Sign up, generate a key, and paste it below
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Uncomment for verbose MCP HTTP logging (default: in-process)
# LOCAL_MCP_HTTP=0

# Optional: CORS origin override (default: http://localhost:3000)
# FRONTEND_ORIGIN=http://localhost:3000
