# Groq API key (optional — deterministic demo works without it)
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# CORS — comma-separated origins (localhost included by default in render.yaml)
# FRONTEND_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://swiggy-nexus-web.onrender.com

# Regex for preview deployments (*.onrender.com, *.vercel.app)
# CORS_ORIGIN_REGEX=https://.*\.(onrender|vercel)\.app

# Mock MCP runs in-process on Render (do not set LOCAL_MCP_HTTP=1 on single worker)
