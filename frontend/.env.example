# -----------------------------------------------------------------------------
# NEXT_PUBLIC_* vars are inlined at build time — redeploy after changes.
# -----------------------------------------------------------------------------

# Demo mode (default): leave blank. UI uses same-origin /api/* Route Handlers.
# NEXT_PUBLIC_API_URL=

# Render Blueprint sets this automatically from swiggy-nexus-api hostname.
# Local FastAPI:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Set to true only when GROQ_API_KEY is configured on the Render API service.
# NEXT_PUBLIC_GROQ_ENABLED=false
