# -----------------------------------------------------------------------------
# NEXT_PUBLIC_* vars are inlined at build time — restart dev server after changes.
# -----------------------------------------------------------------------------

# Demo mode (default): omit this variable or leave it blank. The UI uses
# Route Handlers in app/api/ (SSE + sidebar JSON) on the same Next.js origin.
#
# NEXT_PUBLIC_API_URL=

# Optional — point the UI at a FastAPI (or compatible) backend (no trailing slash):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
